# --- Database (Postgres via Prisma) ---
# Local dev example. Replace with your own connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inci_lab?schema=public"

# --- AI fallback (optional) ---
# If unset, the app falls back to a heuristic classifier so it still runs
# without any external API. See src/lib/ai.ts.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- PostHog analytics ---
# Required in production for dashboards and insights.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Optional reverse proxy path (recommended when rewrites are supported).
# If empty, client sends events directly to NEXT_PUBLIC_POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_PROXY_PATH="/ingest"
